# FiTuna run artifacts
*.gguf
*.gguf.tmp
out/
.fituna_cache.sqlite3

# `fituna fetch-corpus` output: a downloaded corpus, not a project source
# (see README Quickstart step 3) -- covers any --out path, not just the two
# example filenames, since the tool lets users pick any name ending in .txt.
# Also covers its atomic-write temp file, always named `.<out-name>.<random
# suffix>.tmp` next to the destination regardless of --out name (see
# tempfile.mkstemp() in fituna/corpus.py's fetch_corpus()).
*.txt
# ...but don't swallow ordinary repo .txt files this project might add --
# unanchored *.txt would otherwise silently untrack them (`git add` becomes
# a silent no-op instead of an error). Negate the obvious names; a corpus
# file never legitimately uses one of these.
!requirements.txt
!LICENSE.txt
!tests/fixtures/*.txt
.*.tmp

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS
.DS_Store

# Agent scratch workspace (task briefs, reports, backups)
.superpowers/

